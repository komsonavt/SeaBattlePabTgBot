# ===== Telegram-бот =====
# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Username бота без @ (обязательно)
BOT_USERNAME=
# ID форума модерации и его тем обычно задаются в bot.properties.
MODERATION_CHAT_ID=
MODERATION_TOPIC_ID=
EXPORTS_TOPIC_ID=
BROADCASTS_TOPIC_ID=
# id администраторов через запятую (опционально)
ADMIN_IDS=

# ===== Настройки турнира (опционально) =====
GROUP_SIZE=4
PLAYERS_PER_GROUP_ADVANCE=2

# ===== PostgreSQL =====
POSTGRES_DB=seabattle
POSTGRES_USER=seabattle
POSTGRES_PASSWORD=seabattle

# ===== Таймер хода фиксирован: 180 сек в PvP; в игре с ИИ нет таймера =====
TURN_TIMEOUT_SECONDS=180

# Custom emoji configuration for Docker (defaults to ordinary emoji)
BRAND_EMOJI_HOST_FILE=./brand-emoji.example.json
# Путь к основному конфигурационному файлу бота в каталоге проекта.
BOT_CONFIG_HOST_FILE=./bot.properties
# Тексты для бота: редактируются без пересборки приложения.
COPY_HOST_FILE=./copy.xml
